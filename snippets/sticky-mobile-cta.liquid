{% comment %}
  Garden of Jess — Sticky Mobile CTA Bar
  Appears only on mobile devices (< 768px) after scrolling past the primary product form
  Optimized for high-converting 1-tap checkout
{% endcomment %}

<div id="garden-sticky-mobile-cta" class="sticky-mobile-cta-wrapper" aria-hidden="true" style="display: none;">
  <div class="sticky-cta-inner" style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; background: rgba(249, 246, 240, 0.98); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-top: 1px solid #D8CFBC; box-shadow: 0 -4px 16px rgba(45, 56, 35, 0.08);">
    
    <!-- Thumbnail & Title/Price Info -->
    <div class="sticky-info" style="display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1;">
      {% if product.featured_image %}
        <img 
          src="{{ product.featured_image | img_url: '80x80', crop: 'center' }}" 
          alt="{{ product.title | escape }} loose leaf tea tin" 
          width="40" 
          height="40" 
          loading="lazy"
          style="border-radius: 6px; border: 1px solid #EDE8DF; object-fit: cover;"
        >
      {% endif %}
      <div class="sticky-text" style="line-height: 1.2; overflow: hidden;">
        <span style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 15px; font-weight: 600; color: #2D3823; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          {{ product.title }}
        </span>
        <span style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; font-weight: 700; color: #6B7A55;">
          {{ product.price | money }}
        </span>
      </div>
    </div>

    <!-- Instant Action Button -->
    <div class="sticky-action" style="flex-shrink: 0;">
      <button 
        type="button" 
        id="sticky-mobile-add-btn" 
        onclick="document.querySelector('form[action*=\"/cart/add\"] button[type=\"submit\"]').click();"
        style="background: #6B7A55; color: #F9F6F0; border: none; padding: 12px 20px; border-radius: 28px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; font-weight: 600; letter-spacing: 0.3px; cursor: pointer; box-shadow: 0 4px 10px rgba(107, 122, 85, 0.25); display: inline-flex; align-items: center; gap: 6px;"
      >
        <span>Add to Cart</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>

  </div>
</div>

<style>
@media (max-width: 767px) {
  #garden-sticky-mobile-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    transform: translateY(100%);
    opacity: 0;
  }
  #garden-sticky-mobile-cta.is-visible {
    display: block !important;
    transform: translateY(0);
    opacity: 1;
    aria-hidden: false;
  }
  /* Offset body padding when sticky CTA is active to prevent blocking footer content */
  body.has-sticky-cta {
    padding-bottom: 72px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  if (window.innerWidth >= 768) return;

  var stickyBar = document.getElementById('garden-sticky-mobile-cta');
  var mainAddBtn = document.querySelector('form[action*="/cart/add"] button[type="submit"]');

  if (!stickyBar || !mainAddBtn) return;

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting) {
        stickyBar.classList.add('is-visible');
        document.body.classList.add('has-sticky-cta');
      } else {
        stickyBar.classList.remove('is-visible');
        document.body.classList.remove('has-sticky-cta');
      }
    });
  }, { threshold: 0.1 });

  observer.observe(mainAddBtn);
});
</script>
